{
  "name": "@kinetix/core",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.tsx",
  "cracoConfig": "../../configs/craco.config.js",
  "dependencies": {
    "css": "^3.0.0",
    "inversify": "^6.0.1",
    "inversify-binding-decorators": "^4.0.0",
    "keycloak-js": "20.0.3",
    "sass": "^1.77.8",
    "typescript-guid": "^1.0.3",
    "react-gtm-module":"2.0.11",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@types/react-gtm-module":"2.0.4",
    "@types/socket.io-client": "3.0.0"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test:list": "jest --listTests  --json",
    "test": "jest --coverage --testResultsProcessor=\"jest-junit\" --watchAll=false --ci --silent --noStackTrace",
    "test-debug": "jest --coverage --testResultsProcessor=\"jest-junit\" --watch",
    "clean": "rimraf build coverage",
    "eject": "craco eject",
    "circular:check": "madge --circular --extensions ts,tsx src/ > circular-deps.txt",
    "circular:image": "madge --circular --image circular-deps.svg --extensions ts,tsx src/",
    "circular:json": "madge --circular --json --extensions ts,tsx src/ > circular-deps.json"
  },
  "jest-junit": {
    "suiteName": "core-tests",
    "outputDirectory": "./coverage",
    "outputName": "junit.xml",
    "uniqueOutputName": "false"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
