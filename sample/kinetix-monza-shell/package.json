{
  "name": "@kinetix/monza-shell",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.tsx",
  "dependencies": {
    "@kinetix/core": "^1.0.0",
    "css": "^3.0.0"
  },
  "cracoConfig": "../../configs/craco.config.js",
  "scripts": {
    "build": "craco build",
    "test:list": "jest --listTests  --json",
    "test": "jest --coverage --testResultsProcessor=\"jest-junit\" --watchAll=false --ci --silent --noStackTrace",
    "test-debug": "jest --coverage --testResultsProcessor=\"jest-junit\" --watch",
    "clean": "rimraf build coverage",
    "eject": "craco eject",
    "circular:check": "madge --circular --extensions ts,tsx src/ > circular-deps.txt",
    "circular:image": "madge --circular --image circular-deps.svg --extensions ts,tsx src/",
    "circular:json": "madge --circular --json --extensions ts,tsx src/ > circular-deps.json"
  },
  "jest-junit": {
    "suiteName": "monza-shell-tests",
    "outputDirectory": "./coverage",
    "outputName": "junit.xml",
    "uniqueOutputName": "false"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
