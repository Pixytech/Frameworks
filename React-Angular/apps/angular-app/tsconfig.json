{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "emitDeclarationOnly": false,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "../../dist/apps/angular-app",
    "rootDir": "../../",
    "baseUrl": ".",
    "paths": {
      "@mlp/core": ["../../libs/core/src/index.ts"],
      "@mlp/angular": ["../../libs/angular/src/index.ts"],
      "@mlp/react": ["../../libs/react/src/index.ts"],
      "@mlp/rest-limit-monitor": ["../../libs/rest-limit-monitor/src/index.ts"]
    },
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../../libs/angular"
    },
    {
      "path": "../../libs/core"
    }
  ]
}
